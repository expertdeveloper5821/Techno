# Supabase Edge Functions (full URL to each function)
NEXT_PUBLIC_CONTACT_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/send-query-emails
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/subscribe-newsletter

# Optional: required if your Edge Functions verify JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override defaults in ContactFormCard / footer
# NEXT_PUBLIC_SITE_EMAIL=
# NEXT_PUBLIC_SITE_PHONE_DISPLAY=
# NEXT_PUBLIC_SITE_PHONE_TEL=
# NEXT_PUBLIC_SITE_ADDRESS=

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# CMS Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=change-this-to-a-long-random-secret-string-in-production

# ── AWS S3 (image uploads) ────────────────────────────────────────────────────
# All images are stored under the "techno/" folder inside the bucket.
# Get these from AWS IAM → your user → Security credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
# The AWS region your bucket lives in, e.g. us-east-1 / ap-south-1
AWS_REGION=us-east-1
# The exact name of your S3 bucket
AWS_S3_BUCKET_NAME=your-bucket-name
